# Local-only values. Never commit your real .dev.vars.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_ALLOWED_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
# PERSONAL_OS_OWNER_USER_ID=YOUR_USERS_TABLE_UUID

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_DEEP_MODEL=gemini-3.8-flash
# Only configure limits you know from your own dashboard/account.
# GEMINI_35_LITE_DAILY_LIMIT=
# GEMINI_36_DAILY_LIMIT=
GEMINI_37_DAILY_LIMIT=20
# GEMINI_38_DAILY_LIMIT=
GEMINI_35_DAILY_LIMIT=20
# GEMINI_31_LITE_DAILY_LIMIT=

# OpenRouter: one logical free route only. The account-level free-model quota is
# guarded here so the router does not retry across many free model slugs.
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_DAILY_LIMIT=50
OPENROUTER_QUOTA_RESERVE_REQUESTS=5
OPENROUTER_ENFORCE_ZDR=true
OPENROUTER_DENY_DATA_COLLECTION=true
OPENROUTER_ALLOW_PERSONAL_SENSITIVE=false

# NVIDIA hosted NIM. The release script live-tests the current catalog and writes
# only passing models to NVIDIA_NIM_ENABLED_MODELS.
# NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_KEY
NVIDIA_NIM_ENABLED=true
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_ENABLED_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_ALLOW_PERSONAL_SENSITIVE=false
NVIDIA_NIM_TREAT_AS_PAID=false

# Adaptive routing. No provider is a hard default.
MODEL_TIMEOUT_MS=45000
MODEL_TRANSIENT_CIRCUIT_SECONDS=120
PROVIDER_AUTH_CIRCUIT_SECONDS=1800
MODEL_ROUTE_STATE_ENABLED=true
MODEL_PROACTIVE_QUOTA_ROUTING=true
MODEL_QUOTA_RESERVE_REQUESTS=1
MODEL_MAX_ROUTE_ATTEMPTS=5
MODEL_GOOGLE_MAX_ATTEMPTS=2
MODEL_NVIDIA_MAX_ATTEMPTS=2
MODEL_OPENROUTER_MAX_ATTEMPTS=1
MODEL_PROVIDER_BALANCE_ENABLED=true
MODEL_PROVIDER_BALANCE_WINDOW=15
MODEL_PROVIDER_BALANCE_WEIGHT=16
MODEL_PROVIDER_ROTATION_BONUS=6
MODEL_PROVIDER_TARGET_WEIGHTS=google:0.40,nvidia:0.40,openrouter:0.20

ALLOW_PAID_FALLBACK=false
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0

RECENT_MESSAGE_LIMIT=8
RECORD_RETRIEVAL_LIMIT=18
DEEP_RECORD_RETRIEVAL_LIMIT=36
CHUNK_RETRIEVAL_LIMIT=7
DEEP_CHUNK_RETRIEVAL_LIMIT=16
PROFILE_RETRIEVAL_LIMIT=32
HISTORICAL_EVIDENCE_RETRIEVAL_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Optional private speech-recognition vocabulary. Keep real names in .dev.vars only.
# GEMINI_TRANSCRIPTION_VOCABULARY=PrivateName,OrganizationName,ProjectName
MAX_VOICE_SECONDS=600

# Optional local-only diagnostics configuration.
# PERSONAL_OS_AUDIT_TERMS=career,learning,personal os
# PERSONAL_OS_CURRENT_STATE_TERM=career
# PERSONAL_OS_HEALTH_QUERY=personal os
# PERSONAL_OS_ENTITY_CONFIG=imports/private/entities.json
# PERSONAL_OS_OWNER_ALIASES=PrivateOwnerName,PrivateOwnerAlias
# PERSONAL_OS_CAREER_ALIASES=PrivateEmployer,PrivateRole,PrivateProject
# PERSONAL_OS_PRIVATE_MARKERS=PrivateName,PrivateEmployer,PrivateProject
